# Support ticket pipeline: branch on the language, merge again, then reply.
# `translated` is written on BOTH branches, so the analyzer may safely read it.
# A compare block scores the replier against a terse version. The replier already in the flow wins,
# so the compiler keeps it (nothing is swapped without a reason).

state Ticket {
  input message: string
  language: string
  translated: string
  sentiment: string
  summary: string
  output reply: string
}

tool detect_language(text: string) -> string
tool translate(text: string, target: string) -> string

agent detector {
  state.language = detect_language(state.message)
}

agent translator {
  state.translated = translate(state.message, "en")
}

agent passthrough {
  state.translated = state.message
}

agent analyzer {
  state.sentiment = llm("Classify the sentiment", state.translated) one_of ["positive", "negative", "neutral"]
  state.summary = llm("Summarize the ticket", state.translated)
}

agent replier {
  if (state.sentiment == "negative") {
    state.reply = llm("Write an apologetic reply", state.summary)
  } else {
    state.reply = llm("Write a friendly reply", state.summary)
  }
}

# a terse alternative to the replier
agent replier_terse {
  state.reply = llm("Reply in five words or fewer", state.summary)
}

flow support {
  start -> detector
  detector -[state.language != "en"]-> translator
  detector -[else]-> passthrough
  translator -> analyzer
  passthrough -> analyzer
  analyzer -> replier -> end
}

compare best_replier {
  candidates replier, replier_terse

  case {
    state.sentiment = "negative"
    state.summary = "The order arrived broken."
    expect state.reply contains "sorry"
    mock replier "We are sorry the order arrived broken."
    mock replier_terse "Noted."
  }
  case {
    state.sentiment = "positive"
    state.summary = "Great service, thank you."
    expect state.reply contains "thank"
    mock replier "Thank you for the kind words!"
    mock replier_terse "Thanks."
  }
}
