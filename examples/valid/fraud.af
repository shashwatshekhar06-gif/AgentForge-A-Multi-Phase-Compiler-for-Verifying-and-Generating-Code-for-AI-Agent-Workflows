# Fraud investigation: triage a transaction, analyse the transaction graph
# (retrying up to 3 times while not confident), then write a report.
# Two versions of the report writer compete; the compare block at the end picks the better one
# and the compiler wires it into the generated code.

state FraudCase {
  input transaction_id: string
  input amount: int
  risk: string
  evidence: list[string] = []
  graph_score: int = 0
  confident: bool = false
  output report: string
}

tool fetch_transactions(transaction_id: string) -> list[string]
tool score_graph(evidence: list[string]) -> int

agent triage {
  if (state.amount > 10000) {
    state.risk = "high"
  } else {
    state.risk = llm("Rate the fraud risk of this transaction", state.transaction_id, state.amount) one_of ["high", "low"]
  }
}

agent graph_analyst {
  state.evidence = fetch_transactions(state.transaction_id)
  state.graph_score = score_graph(state.evidence)
  state.confident = state.graph_score > 70
}

agent report_writer {
  state.report = llm("Write a fraud report", state.transaction_id, state.risk, state.evidence, state.graph_score)
}

# a second version of the report writer, with a more demanding prompt
agent report_writer_v2 {
  state.report = llm("Write a fraud report that names the transaction id, the risk level and the strongest evidence", state.transaction_id, state.risk, state.evidence, state.graph_score)
}

flow investigate {
  start -> triage
  triage -[state.risk == "high"]-> graph_analyst
  triage -[else]-> report_writer
  graph_analyst -[not state.confident, max_iterations 3]-> graph_analyst   # bounded retry loop
  graph_analyst -[else]-> report_writer
  report_writer -> end
}

compare best_report_writer {
  candidates report_writer, report_writer_v2

  case {
    state.transaction_id = "TX-1001"
    state.risk = "high"
    state.graph_score = 82
    expect state.report contains "TX-1001"
    mock report_writer "Fraud report: this looks suspicious."
    mock report_writer_v2 "Fraud report for TX-1001: high risk, three linked accounts."
  }
  case {
    state.transaction_id = "TX-2002"
    state.risk = "low"
    expect state.report contains "low"
    mock report_writer "Fraud report: low risk."
    mock report_writer_v2 "Fraud report for TX-2002: low risk, no evidence found."
  }
}
