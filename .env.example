# Copy this file to backend/.env and fill in your key. backend/.env is git-ignored: never commit a real key.
# The compiler (python -m compiler ... --profile real) and generated workflow.py files read it automatically.
# Variables already set in your terminal win over this file.

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# optional
# AGENTFORGE_PROVIDER=openai     # openai or anthropic (default: openai when OPENAI_API_KEY is set)
# AGENTFORGE_MODEL=gpt-4o-mini
# AGENTFORGE_LLM=real            # make every workflow.py run use the real model instead of the mock
